{
  "name": "whatsapp-api",
  "version": "1.0.0",
  "description": "WhatsApp Web Automation API with Playwright",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "docker:build": "docker build -t whatsapp-api .",
    "docker:run": "docker run -p 3000:3000 -v whatsapp_data:/app/data whatsapp-api"
  },
  "keywords": [
    "whatsapp",
    "automation",
    "playwright",
    "api"
  ],
  "author": {
    "name": "rajivranjanmars",
    "url": "https://rajivranjana.in"
  },
  "license": "MIT",
  "dependencies": {
    "@playwright/browser-chromium": "1.63.0",
    "playwright": "1.63.0",
    "fastify": "^5.12.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.7.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
