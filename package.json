{
  "name": "whatsapp-api",
  "version": "1.0.0",
  "description": "WhatsApp Web Automation API with Playwright",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "docker:build": "docker build -t whatsapp-api .",
    "docker:run": "docker run -p 3000:3000 -v whatsapp_data:/app/data whatsapp-api"
  },
  "keywords": ["whatsapp", "automation", "playwright", "api"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@playwright/browser-chromium": "^1.40.0",
    "playwright": "^1.40.0",
    "fastify": "^4.25.1",
    "@fastify/cors": "^8.4.2",
    "@fastify/multipart": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
